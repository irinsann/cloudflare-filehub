{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "irin-drive",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    { "pattern": "ps-filehub.080280.xyz", "custom_domain": true },
    { "pattern": "md-filehub.080280.xyz", "custom_domain": true },
    { "pattern": "s-filehub.080280.xyz", "custom_domain": true },
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "irin-drive-private" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "irin-drive",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../db/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LOCAL_AUTH": "false",
    "MAX_UPLOAD_BYTES": "20971520",
    "MAX_TEXT_BYTES": "1048576",
    "ADMIN_ORIGIN": "https://ps-filehub.080280.xyz",
    "MARKDOWN_ORIGIN": "https://md-filehub.080280.xyz",
    "FILES_ORIGIN": "https://s-filehub.080280.xyz",
    "ACCESS_TEAM_DOMAIN": "YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_APPLICATION_AUD",
    "ADMIN_EMAILS": "YOUR_ADMIN_EMAIL",
  },
  "triggers": { "crons": ["17 * * * *"] },
}
