{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "cloudflare-filehub",
  "main": "../worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "routes": [
    {
      "pattern": "cloud.example.com",
      "custom_domain": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "filehub-storage",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "filehub-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "../db/migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "LOCAL_AUTH": "false",
    "MAX_TEXT_BYTES": "1048576",
    "ADMIN_ORIGIN": "https://cloud.example.com",
    "MARKDOWN_ORIGIN": "https://cloud.example.com",
    "FILES_ORIGIN": "https://files.example.com",
    "TRUSTED_PROXY_ORIGINS": "https://files.example.com",
    "ACCESS_TEAM_DOMAIN": "YOUR_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_APPLICATION_AUD",
    "ADMIN_EMAILS": "YOUR_ADMIN_EMAIL",
  },
  "triggers": {
    "crons": ["17 * * * *"],
  },
}
