{
  "name": "cloudflare-filehub",
  "license": "MIT",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm build && wrangler dev --env local",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm worker:check",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-build",
    "db:local": "wrangler d1 migrations apply DB --local --env local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "node scripts/preflight.mjs && pnpm build && wrangler deploy",
    "cleanup:local": "wrangler dev --env local --test-scheduled",
    "db:production": "wrangler d1 migrations apply DB --remote --config wrangler.production.jsonc",
    "deploy:production": "node scripts/preflight.mjs wrangler.production.jsonc && pnpm build && wrangler deploy --config wrangler.production.jsonc"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language-data": "^6.5.0",
    "@fastify/busboy": "3.2.3",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-slot": "^1.2.0",
    "@uiw/react-codemirror": "^4.25.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.10.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.468.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "saxes": "^6.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/hast": "^3.0.0",
    "@types/mdast": "^4.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^10.12.0",
    "jsonc-parser": "3.3.1",
    "prettier": "3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.45.0"
  }
}
